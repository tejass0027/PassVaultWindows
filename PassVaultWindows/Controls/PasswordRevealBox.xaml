<UserControl x:Class="PassVaultWindows.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <PasswordBox x:Name="MaskedBox" PasswordChanged="MaskedBox_PasswordChanged" />
            <TextBox x:Name="RevealedBox" Visibility="Collapsed" TextChanged="RevealedBox_TextChanged" />
        </Grid>
        <Button x:Name="ToggleButton" Grid.Column="1" Content="Show" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleButton_Click" Margin="4,0,0,0" />
    </Grid>
</UserControl>
