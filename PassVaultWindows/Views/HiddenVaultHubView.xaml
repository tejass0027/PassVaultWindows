<UserControl x:Class="PassVaultWindows.Views.HiddenVaultHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#128274;" Style="{StaticResource IconButtonStyle}" Click="Lock_Click" ToolTip="Lock" />
                <TextBlock Grid.Column="1" Text="Private vault" Style="{StaticResource HeadlineTextStyle}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,8">
            <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14" Click="Passwords_Click">
                <StackPanel>
                    <TextBlock Text="Secret passwords" />
                    <TextBlock Text="Passwords only you know about" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14" Click="Photos_Click">
                <StackPanel>
                    <TextBlock Text="Secret photos" />
                    <TextBlock Text="Pictures kept private" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14" Click="Notes_Click">
                <StackPanel>
                    <TextBlock Text="Secret notes" />
                    <TextBlock Text="Codes, PINs, anything you want to jot down" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Button>
            <Separator />
        </StackPanel>
    </Grid>
</UserControl>
