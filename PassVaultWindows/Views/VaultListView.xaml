<UserControl x:Class="PassVaultWindows.Views.VaultListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#128274;" Style="{StaticResource IconButtonStyle}" Click="Lock_Click" ToolTip="Lock" />
                <TextBlock Grid.Column="1" Text="PassVault" Style="{StaticResource HeadlineTextStyle}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="&#128247;" Style="{StaticResource IconButtonStyle}" Click="PhotoVault_Click" ToolTip="Photo vault" />
                <Button Grid.Column="3" Content="&#9881;" Style="{StaticResource IconButtonStyle}" Click="Settings_Click" ToolTip="Settings" />
            </Grid>
        </Border>

        <Border x:Name="BannerBorder" Grid.Row="1" Background="{DynamicResource ErrorContainerBrush}" Margin="12,12,12,0" Padding="12" CornerRadius="8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="BannerTitleText" Foreground="{DynamicResource OnErrorContainerBrush}" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock x:Name="BannerSubtitleText" Foreground="{DynamicResource OnErrorContainerBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,4" />
                    <Button Content="View activity" Style="{StaticResource SecondaryButtonStyle}" Padding="0" HorizontalAlignment="Left" Click="ViewActivity_Click" />
                </StackPanel>
                <Button Grid.Column="1" Content="&#10005;" Style="{StaticResource IconButtonStyle}" Click="DismissBanner_Click" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12">
            <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" Padding="10,0,0,0" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="SearchPlaceholder" Text="Search" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" Visibility="Collapsed" />
            <ListBox x:Name="CredentialsList" BorderThickness="0" Background="Transparent" MouseDoubleClick="CredentialsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Title}" FontSize="14" />
                            <TextBlock Text="{Binding Username}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="AddButton" Content="+" FontSize="22" Width="52" Height="52" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click" ToolTip="Add entry" />
        </Grid>
    </Grid>
</UserControl>
