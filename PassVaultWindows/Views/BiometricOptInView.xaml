<UserControl x:Class="PassVaultWindows.Views.BiometricOptInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="32">
            <TextBlock x:Name="TitleText" Style="{StaticResource HeadlineTextStyle}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryTextStyle}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,32" />
            <Button x:Name="EnableButton" Content="Enable Windows Hello" Style="{StaticResource PrimaryButtonStyle}" Click="Enable_Click" Visibility="Collapsed" />
            <Button x:Name="SkipButton" Content="Skip, use pattern only" Style="{StaticResource SecondaryButtonStyle}" Click="Skip_Click" Margin="0,8,0,0" Visibility="Collapsed" />
            <Button x:Name="FinishButton" Content="Finish setup" Style="{StaticResource PrimaryButtonStyle}" Click="Finish_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
