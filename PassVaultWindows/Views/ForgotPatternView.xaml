<UserControl x:Class="PassVaultWindows.Views.ForgotPatternView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultWindows.Controls">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel x:Name="NoQuestionsPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="32" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="No security questions were set up, so this PC can't be recovered this way." />
            <Button Content="Back to login" Style="{StaticResource PrimaryButtonStyle}" Click="BackToLogin_Click" Margin="0,16,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="AnswersScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="32">
                <TextBlock Text="Answer your security questions" Style="{StaticResource HeadlineTextStyle}" FontSize="20" Margin="0,0,0,20" />
                <TextBlock x:Name="Question1Label" Margin="0,0,0,4" />
                <controls:PasswordRevealBox x:Name="Answer1Box" Height="34" Margin="0,0,0,16" />
                <TextBlock x:Name="Question2Label" Margin="0,0,0,4" />
                <controls:PasswordRevealBox x:Name="Answer2Box" Height="34" Margin="0,0,0,16" />
                <TextBlock x:Name="Question3Label" Margin="0,0,0,4" />
                <controls:PasswordRevealBox x:Name="Answer3Box" Height="34" Margin="0,0,0,16" />
                <TextBlock x:Name="AnswersErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Click="Continue_Click" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,8,0,0" />
                <ProgressBar x:Name="AnswersProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="PatternStepPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" Visibility="Collapsed">
            <TextBlock x:Name="PatternStepTitle" Style="{StaticResource HeadlineTextStyle}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" />
            <controls:PatternLockControl x:Name="NewPatternControl" Width="280" Height="280" HorizontalAlignment="Center" />
            <ProgressBar x:Name="PatternProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
