<UserControl x:Class="PassVaultWindows.Views.BackupExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultWindows.Controls">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" MaxWidth="380" Margin="32">
            <TextBlock Text="Export encrypted backup" Style="{StaticResource HeadlineTextStyle}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,24"
                       Text="Choose a password for this backup file. You'll need it to restore the backup later, so don't lose it - it's separate from your pattern." />

            <TextBlock Text="Backup password" Margin="0,0,0,4" />
            <controls:PasswordRevealBox x:Name="PasswordBox" Height="34" Margin="0,0,0,12" />
            <TextBlock Text="Confirm password" Margin="0,0,0,4" />
            <controls:PasswordRevealBox x:Name="ConfirmPasswordBox" Height="34" Margin="0,0,0,16" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12" />

            <Button x:Name="SaveButton" Content="Choose location and save" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,12,0,0" />

            <Button Content="Done" Style="{StaticResource SecondaryButtonStyle}" Click="Done_Click" Margin="0,8,0,0" />
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</UserControl>
