<UserControl x:Class="PassVaultWindows.Views.EntryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#8592;" Style="{StaticResource IconButtonStyle}" Click="Back_Click" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource HeadlineTextStyle}" FontSize="16" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="&#9998;" Style="{StaticResource IconButtonStyle}" Click="Edit_Click" ToolTip="Edit" />
                <Button Grid.Column="3" Content="&#128465;" Style="{StaticResource IconButtonStyle}" Click="Delete_Click" ToolTip="Delete" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock Text="Username" Style="{StaticResource SecondaryTextStyle}" />
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UsernameText" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Click="CopyUsername_Click" />
            </Grid>

            <TextBlock Text="Password" Style="{StaticResource SecondaryTextStyle}" />
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PasswordText" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Consolas" />
                <Button x:Name="ToggleShowButton" Grid.Column="1" Content="Show" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleShow_Click" />
                <Button Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Click="CopyPassword_Click" />
            </Grid>

            <StackPanel x:Name="UrlPanel" Visibility="Collapsed">
                <TextBlock Text="Website" Style="{StaticResource SecondaryTextStyle}" />
                <Grid Margin="0,4,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UrlText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Click="CopyUrl_Click" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="NotesPanel" Visibility="Collapsed">
                <TextBlock Text="Notes" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
