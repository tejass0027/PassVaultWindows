<UserControl x:Class="PassVaultWindows.Views.BackupImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultWindows.Controls">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" MaxWidth="380" Margin="32">
            <TextBlock Text="Import backup" Style="{StaticResource HeadlineTextStyle}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,24"
                       Text="Enter the password you set when this backup was created, then choose the file. This also works with a backup exported from the Android app." />

            <TextBlock Text="Backup password" Margin="0,0,0,4" />
            <controls:PasswordRevealBox x:Name="PasswordBox" Height="34" Margin="0,0,0,16" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" Margin="0,0,0,12" />

            <Button x:Name="ChooseFileButton" Content="Choose backup file" Style="{StaticResource PrimaryButtonStyle}" Click="ChooseFile_Click" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,12,0,0" />

            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
